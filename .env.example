# Copy this file to .env and fill in your values.
# Required for EAS builds and push notifications after switching Expo accounts.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OCR.space (receipt scanning)
EXPO_PUBLIC_OCR_SPACE_API_KEY=

# Analytics (optional)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=

# Expo – set after creating/linking project in your Expo account (expo.dev)
# Run: eas login (new account) then create/link project; copy Project ID from dashboard.
EXPO_PUBLIC_PROJECT_ID=

# Optional (if using Rork toolkit)
EXPO_PUBLIC_RORK_API_BASE_URL=
EXPO_PUBLIC_TOOLKIT_URL=
EXPO_PUBLIC_TEAM_ID=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=
